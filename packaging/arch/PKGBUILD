# Maintainer: Dukko <dukkokun@gmail.com>
pkgname=drukhal-manager-git
_app=io.github.dukko.DrukhalManager
pkgver=r20.034e808
pkgrel=1
pkgdesc="Native Linux mod manager for Stellaris with AI-assisted merging, a fork of Irony Mod Manager"
arch=('x86_64' 'aarch64')
url="https://github.com/Dukko/DrukhalManager"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'hicolor-icon-theme')
makedepends=('cargo' 'git' 'gettext')
provides=('drukhal-manager')
conflicts=('drukhal-manager')
options=('!lto')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/drukhal-manager "$pkgdir/usr/bin/drukhal-manager"
  install -Dm644 "data/$_app.desktop" "$pkgdir/usr/share/applications/$_app.desktop"
  install -Dm644 "data/$_app.metainfo.xml" "$pkgdir/usr/share/metainfo/$_app.metainfo.xml"
  install -Dm644 "data/icons/$_app.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_app.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  if [ -d target/i18n/locale ]; then
    install -d "$pkgdir/usr/share/locale"
    cp -r target/i18n/locale/. "$pkgdir/usr/share/locale/"
  fi
}
